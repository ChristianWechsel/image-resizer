{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Unit Tests",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "npm: build-test",
      "runtimeArgs": [
        "--inspect",
        "${workspaceFolder}/node_modules/jest/bin/jest.js",
        "--runInBand",
        "--selectProjects",
        "Unit"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Debug Int Tests",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "npm: build-test",
      "runtimeArgs": [
        "--inspect",
        "${workspaceFolder}/node_modules/jest/bin/jest.js",
        "--runInBand",
        "--selectProjects",
        "Integration"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Debug E2E Tests",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "npm: build-test",
      "runtimeArgs": [
        "--inspect",
        "${workspaceFolder}/node_modules/jest/bin/jest.js",
        "--runInBand",
        "--selectProjects",
        "E2E"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Debug",
      "address": "127.0.0.1",
      "port": 9229,
      "request": "attach",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "type": "node"
    }
  ]
}